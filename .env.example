# ==========================================
# Morpheus AI - Environment Configuration
# ==========================================

# Groq API Key (Required for Llama models, Whisper STT, and Orpheus TTS)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional: for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional: for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Optional: for chat history persistence)
# Example: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=
